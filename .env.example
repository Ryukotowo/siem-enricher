# Пример переменных окружения. Скопируйте в .env и заполните.
# Значения подставляются в config/*.json через синтаксис ${VAR:-default}.

SIEM_ENRICHER_LOG_LEVEL=INFO
SIEM_ENRICHER_INSTANCE_ID=enricher-1

# --- Основной канал событий: Kafka (источник и обратный коннектор) ---
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_INPUT_TOPIC=siem.raw.events
KAFKA_OUTPUT_TOPIC=siem.enriched.events
KAFKA_CONSUMER_GROUP=siem-enricher
KAFKA_SECURITY_PROTOCOL=PLAINTEXT      # SASL_PLAINTEXT / SASL_SSL при защищённом кластере
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# --- Хранилище цепочек происхождения ---
PROVENANCE_BACKEND=sqlite              # memory | sqlite | redis
REDIS_URL=redis://localhost:6379/0

# --- ML-классификатор конфиденциальности ---
ML_ARTIFACT=ml/artifacts/sensitivity_transformer
ML_DEVICE=auto                         # auto | cpu | cuda
ML_TYPE=auto                           # auto | hybrid | transformer | sklearn | heuristic

# --- Политики ---
POLICY_FILE=config/policies.json
POLICY_MODE=dry_run                    # dry_run | live
POLICY_WEBHOOK_URL=                    # уведомления/блокировка через SOAR или EDR
POLICY_TOKEN_SECRET=                   # секрет для стратегии маскирования tokenize
