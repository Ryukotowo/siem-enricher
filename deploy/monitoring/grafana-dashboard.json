{
  "annotations": {"list": []},
  "editable": true,
  "title": "siem-enricher",
  "uid": "siem-enricher",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Поток событий и обогащение",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "targets": [
        {"expr": "rate(siem_enricher_events_consumed_total[1m])", "legendFormat": "получено", "refId": "A"},
        {"expr": "rate(siem_enricher_events_enriched_total[1m])", "legendFormat": "обогащено", "refId": "B"}
      ]
    },
    {
      "id": 2,
      "type": "piechart",
      "title": "Решения политик",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "sum by (decision) (siem_enricher_policy_decisions_total)", "legendFormat": "{{decision}}", "refId": "A"}
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Задержка обогащения, p50 / p95 / p99",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(siem_enricher_enrichment_duration_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(siem_enricher_enrichment_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(siem_enricher_enrichment_duration_seconds_bucket[5m])))", "legendFormat": "p99", "refId": "C"}
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Классы конфиденциальности",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "sum by (level) (rate(siem_enricher_sensitivity_classified_total[5m]))", "legendFormat": "{{level}}", "refId": "A"}
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Доля попаданий в кэш классификации",
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "targets": [
        {"expr": "siem_enricher_classifier_cache_hits / (siem_enricher_classifier_cache_hits + siem_enricher_classifier_cache_misses)", "refId": "A"}
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Оценки аналитиков и изменения настроек",
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 8},
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "targets": [
        {"expr": "sum(siem_enricher_analyst_labels_total)", "legendFormat": "метки", "refId": "A"},
        {"expr": "sum(siem_enricher_config_changes_total)", "legendFormat": "изменения", "refId": "B"}
      ]
    }
  ]
}
